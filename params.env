####################################################################################################
# IT Support Orchestrator API - application environment                                            #
#                                                                                                  #
# HOW TO USE: rename this file to '.env' in the repository root, then fill in the values below.    #
# A file named '.env' is git-ignored, so your filled-in copy stays on your machine.                #
#                                                                                                  #
# DO NOT put real credentials in THIS file: it is tracked, and the repository is readable by       #
# anyone who can see it. Keep the placeholders here and put real values only in your local '.env'. #
#                                                                                                  #
# These are the APPLICATION's settings, read by app/core/config.py and shared by every agent.      #
# An agent's own connection details live beside that agent's code.                                 #
#                                                                                                  #
# On App Service every name below is set as an Application Setting instead, so no file is used.    #
####################################################################################################

# --- Azure AI Foundry ---------------------------------------------------------------------------
# The project the application connects to. One client is built per worker and handed to every
# agent, so this is the only place the endpoint is configured.
AZURE_FOUNDRY_PROJECT_ENDPOINT=https://<resource>.services.ai.azure.com/api/projects/<project>

# --- State store --------------------------------------------------------------------------------
# Set SQLITE_DB_PATH to run against a local file database, with no Azure SQL and no driver needed.
# Leave it empty and set SQL_CONNECTION_STRING to use Azure SQL.
SQLITE_DB_PATH=local.db
SQL_CONNECTION_STRING=

# --- Local development switches -------------------------------------------------------------------
# The background sweep that finishes abandoned jobs. Turn it off locally when it is noise.
REAPER_ENABLED=false
# DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO

# --- Frontend / transport -------------------------------------------------------------------------
# Comma-separated origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
