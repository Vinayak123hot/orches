####################################################################################################
# Outlook Support Classification Agent - local environment                                         #
#                                                                                                  #
# HOW TO USE: rename this file to '.env' in this same folder, then fill in the values below.      #
# A file named '.env' is git-ignored, so your filled-in copy stays on your machine.                #
#                                                                                                  #
# DO NOT put real credentials in THIS file: it is tracked, and the repository is readable by       #
# anyone who can see it. Keep the placeholders here and put real values only in your local '.env'. #
#                                                                                                  #
# On App Service these same names are set as Application Settings (ideally Key Vault references),  #
# so the deployed application reads them from the environment and no file is involved.             #
####################################################################################################

# --- The knowledge search endpoint --------------------------------------------------------------
# The full URL, without any query string. The query parameters are added per request.
SERVICENOW_API_BASE_URL=https://ap.tevapharm.com/gateway/serviceNowAgenticAIAPI/1.0/api/tpi/aiapi/aisearch

# --- Credentials --------------------------------------------------------------------------------
# Sent as the Authorization header: "Bearer <token>".
SERVICENOW_API_BEARER_TOKEN=<paste the bearer token here>

# Identifies this integration to the service.
SERVICENOW_API_REGISTRATION_ID=<paste the registration id here>

# --- Fixed query parameters ---------------------------------------------------------------------
# The account the search runs as.
SERVICENOW_API_USER_ID=<paste the service account, e.g. name@company.com>

# Constants the endpoint expects on every request.
SERVICENOW_API_REQ_TYPE=search
SERVICENOW_API_SEARCH_TYPE=knowledge
